{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITDA OCR annotation record v1",
  "type": "object",
  "required": ["schema_version", "image_id", "source_image_id", "image_path", "image_sha256", "width", "height", "final_date", "final_date_review", "regions", "quality_tags", "difficulty", "group_id", "group_evidence", "review", "revision"],
  "properties": {
    "schema_version": {"const": 1},
    "image_id": {"type": "string", "pattern": "^[AB]MLC[0-9]{6}$"},
    "source_image_id": {"type": "string", "pattern": "^[0-9]{6}$"},
    "image_path": {"type": "string"},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "final_date": {"type": "string", "pattern": "^(NONE|[0-9]{4}-[0-9]{2}-[0-9]{2}|NONE-[0-9]{2}-[0-9]{2}|[0-9]{4}-[0-9]{2}-NONE)$"},
    "final_date_review": {"type": "object", "required": ["status", "scope", "reviewer", "method", "source"]},
    "group_id": {"type": "string", "minLength": 1},
    "group_evidence": {"type": "string"},
    "difficulty": {"enum": ["easy", "medium", "hard", "unassessed"]},
    "quality_tags": {"type": "array", "uniqueItems": true, "items": {"enum": ["reflection", "curved", "bleed", "dot_print", "low_resolution", "blur", "rotation", "low_contrast"]}},
    "revision": {"type": "integer", "minimum": 0},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "review": {
      "type": "object",
      "required": ["status", "reviewer", "approved_at", "date_regions_complete", "header_regions_complete", "quality_reviewed", "group_reviewed", "no_date_regions"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "reviewer": {"type": "string"},
        "approved_at": {"type": ["string", "null"]},
        "date_regions_complete": {"type": "boolean"},
        "header_regions_complete": {"type": "boolean"},
        "quality_reviewed": {"type": "boolean"},
        "group_reviewed": {"type": "boolean"},
        "no_date_regions": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "field_state": {"enum": ["present", "absent", "occluded", "unreadable", "unknown"]},
    "region": {
      "type": "object",
      "required": ["region_id", "kind", "polygon", "transcription", "role", "role_basis", "role_evidence", "header_region_ids", "field_states", "occluded_characters", "separators", "time_text", "lot_text", "legibility", "status", "notes", "provenance"],
      "properties": {
        "region_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "kind": {"enum": ["date_line", "date_block", "header", "lot", "time", "other"]},
        "polygon": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "transcription": {"type": "string"},
        "role": {"enum": ["expiry", "manufacture", "other", null]},
        "role_basis": {"enum": ["visible_header", "package_context", "reviewer_inference", "undetermined"]},
        "role_evidence": {"type": "string"},
        "header_region_ids": {"type": "array", "items": {"type": "string"}},
        "field_states": {"type": "object", "required": ["year", "month", "day"], "properties": {"year": {"$ref": "#/$defs/field_state"}, "month": {"$ref": "#/$defs/field_state"}, "day": {"$ref": "#/$defs/field_state"}}},
        "occluded_characters": {"type": "array", "items": {"type": "object"}},
        "separators": {"type": "string"},
        "time_text": {"type": "string"},
        "lot_text": {"type": "string"},
        "legibility": {"enum": ["unknown", "readable", "partially_occluded", "unreadable"]},
        "status": {"enum": ["pending", "checked", "rejected"]},
        "notes": {"type": "string"},
        "provenance": {"type": "object", "required": ["type"]}
      }
    }
  }
}
